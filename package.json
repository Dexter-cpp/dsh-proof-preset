{
  "name": "@local/dsh-proof-preset",
  "version": "1.4.1",
  "private": true,
  "description": "DeepSeek Harness 求证模式：从复杂度与正确性论证出发，在有限预算内对拍；用假设账本、反例登记与状态触发的止损避免空转。",
  "type": "module",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Dexter-cpp/dsh-proof-preset.git"
  },
  "homepage": "https://github.com/Dexter-cpp/dsh-proof-preset#readme",
  "bugs": {
    "url": "https://github.com/Dexter-cpp/dsh-proof-preset/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "agent-preset",
    "proof",
    "oi",
    "stress-test"
  ],
  "scripts": {
    "test": "node --test loop-guard.test.cjs memory.test.cjs parity.test.cjs",
    "parity": "node sync-runtime.cjs --check"
  },
  "files": [
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "MIGRATION.md",
    "memory.cjs",
    "loop-guard.cjs",
    "state-bus.cjs",
    "ledger.cjs",
    "runtime-parity.json",
    "loop-guard.test.cjs",
    "memory.test.cjs",
    "parity.test.cjs",
    "sync-runtime.cjs"
  ]
}
